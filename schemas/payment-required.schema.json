{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifinpay.io/schemas/aifp-2/payment-required.schema.json",
  "title": "AIFP-2 Payment Required",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "resource", "nonce", "expires_at", "accepts"],
  "properties": {
    "protocol": { "const": "AIFP-2" },
    "version": { "const": "0.1" },
    "resource": { "type": "string", "minLength": 1 },
    "nonce": { "type": "string", "minLength": 16 },
    "expires_at": { "type": "string", "format": "date-time" },
    "accepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scheme", "network", "asset", "amount_atomic", "pay_to", "fee_bps"],
        "properties": {
          "scheme": { "type": "string", "enum": ["aifp2-exact", "x402-exact"] },
          "network": { "type": "string", "minLength": 3 },
          "asset": { "type": "string", "minLength": 1 },
          "amount_atomic": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "pay_to": { "type": "string", "minLength": 1 },
          "fee_bps": { "const": 0 },
          "extra": { "type": "object" }
        }
      }
    }
  }
}

